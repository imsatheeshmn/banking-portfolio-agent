# Environment Configuration Template
# DO NOT COMMIT SECRETS OR REAL CREDENTIALS. Copy this file to .env locally.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_app
POSTGRES_PASSWORD=portfolio_dev_secret

# Database URLs
DATABASE_URL=postgresql+psycopg://portfolio_app:portfolio_dev_secret@localhost:5432/portfolio_db
ASYNC_DATABASE_URL=postgresql+psycopg_async://portfolio_app:portfolio_dev_secret@localhost:5432/portfolio_db

# Security & Audit
SECRET_KEY=dev_insecure_key_change_in_production_32bytes_min
API_V1_STR=/api/v1
RUN_ID_PREFIX=RUN
